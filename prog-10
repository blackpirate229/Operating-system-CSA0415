#include <stdio.h>
#include <sys/ipc.h>
#include <sys/msg.h>

struct msg {
    long type;
    char text[100];
};

int main() {
    int id;
    struct msg m;

    id = msgget(IPC_PRIVATE, 0666 | IPC_CREAT);

    m.type = 1;
    printf("Enter message: ");
    fgets(m.text, 100, stdin);

    msgsnd(id, &m, sizeof(m.text), 0);
    msgrcv(id, &m, sizeof(m.text), 1, 0);

    printf("Received message: %s", m.text);

    msgctl(id, IPC_RMID, NULL);
    return 0;
}
