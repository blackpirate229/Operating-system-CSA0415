#include <stdio.h>
#include <sys/ipc.h>
#include <sys/shm.h>

int main() {
    int id;
    char *str;

    id = shmget(IPC_PRIVATE, 1024, 0666 | IPC_CREAT);
    str = (char *)shmat(id, NULL, 0);

    printf("Enter message: ");
    fgets(str, 100, stdin);

    printf("Shared Memory Message: %s", str);

    shmdt(str);
    shmctl(id, IPC_RMID, NULL);

    return 0;
}
