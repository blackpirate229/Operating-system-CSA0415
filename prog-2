
#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int source, destination;
    char buffer[1024];
    ssize_t n;

    // Open the source file
    source = open("source.txt", O_RDONLY);

    if (source < 0) {
        perror("Error opening source file");
        exit(1);
    }

    // Create or open the destination file
    destination = open("destination.txt",
                       O_WRONLY | O_CREAT | O_TRUNC,
                       0644);

    if (destination < 0) {
        perror("Error opening destination file");
        close(source);
        exit(1);
    }

    // Read and write contents
    while ((n = read(source, buffer, sizeof(buffer))) > 0) {
        ssize_t written = 0;

        while (written < n) {
            ssize_t w = write(destination,
                              buffer + written,
                              n - written);

            if (w <= 0) {
                perror("Error writing file");
                close(source);
                close(destination);
                exit(1);
            }

            written += w;
        }
    }

    if (n < 0) {
        perror("Error reading file");
    }

    // Close both files
    close(source);
    close(destination);

    if (n < 0)
        return 1;

    printf("File copied successfully!\n");

    return 0;
}
