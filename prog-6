#include <stdio.h>

int main() {
    int n, i, time=0, bt[20], rt[20], p[20], done=0, min;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i=0; i<n; i++) {
        printf("Enter burst time and priority: ");
        scanf("%d%d", &bt[i], &p[i]);
        rt[i] = bt[i];
    }

    while(done < n) {
        min = -1;

        for(i=0; i<n; i++)
            if(rt[i]>0 && (min==-1 || p[i]<p[min]))
                min=i;

        if(min==-1) break;

        rt[min]--;
        time++;

        if(rt[min]==0) done++;
    }

    printf("\nAll processes completed at time %d\n", time);

    return 0;
}
